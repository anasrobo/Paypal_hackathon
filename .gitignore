# GroundTruth — Node/Next gitignore
#
# The upstream repo shipped GitHub's Python template, whose bare `lib/`, `build/`,
# `dist/`, `cover/`, `instance/`, `env/`, `ENV/`, `var/`, `parts/`, `wheels/` and
# `eggs/` patterns match at ANY depth. Git cannot re-include files under an
# excluded directory, so a bare `lib/` silently untracked whole source trees.
# This file is Node-only and uses root-anchored patterns.
#
# Independent second defence: this project has NO directory named `lib/`.
# See docs/DECISIONS.md D-8.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/
/next-env.d.ts

# production
/build

# vercel
.vercel

# misc
.DS_Store
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# env files — every variant is ignored, then .env.example is opted back in.
# Without the negation below, the `.env*` rule would also hide the template.
.env*
!.env.example

# secrets and keys — never commit these
*.pem
*.key
*.p12
*.pfx
*.p8
*.crt

# typescript
*.tsbuildinfo

# os
Thumbs.db
ehthumbs.db
Desktop.ini

# editor and merge leftovers
*.bak
*.orig
*.rej
*.swp
