# GroundTruth — every environment variable, with dummy values only.
# Copy to .env.local and fill in real values. Never commit a real value.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The single local -> cloud swap point. In production this MUST be the Supabase
# POOLER host (session mode, port 5432). The direct host (db.<ref>.supabase.co)
# is IPv6-only and Vercel cannot reach it. src/server/db/client.ts throws at
# startup in production if the host is not a pooler host.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/groundtruth
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/groundtruth_test

# ---------------------------------------------------------------------------
# Supabase (Storage only — the database is reached through DATABASE_URL)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_placeholder
SUPABASE_STORAGE_BUCKET=evidence

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# PAYPAL_PROVIDER: mock | sandbox   (never "live")
PAYPAL_PROVIDER=mock
PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=AY0000000000000000
PAYPAL_CLIENT_SECRET=EB0000000000000000
PAYPAL_WEBHOOK_ID=8UH00000000000000
PAYPAL_WEBHOOK_SECRET=ERCF00000000000000
# HMAC key the mock provider uses to sign its self-delivered webhook.
PAYPAL_MOCK_WEBHOOK_SECRET=mock-webhook-secret-placeholder
# A recipient address that makes the mock provider deterministically fail.
# Used to seed the PAYOUT_FAILED demo row.
PAYPAL_MOCK_FAIL_EMAIL=payout-fail@demo.test

# VISION_PROVIDER: mock | openai
VISION_PROVIDER=mock
VISION_API_KEY=sk-placeholder-not-used
VISION_MODEL=placeholder-vision-model
# Simulated latency so the demo reads as "the model is thinking" on video.
MOCK_VISION_LATENCY_MS=150
MOCK_PAYPAL_LATENCY_MS=250

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# At least 32 random characters. Startup refuses to run in production with the
# placeholder value.
TOKEN_SECRET=change-me-32-chars-minimum-placeholder
CRON_SECRET=change-me-cron-secret-placeholder

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL. In production this MUST be the deployed origin, because the
# mock provider posts its signed webhook back to {APP_URL}/api/paypal/webhook.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GroundTruth
