{
  "name": "groundtruth",
  "version": "0.1.0",
  "private": true,
  "description": "GroundTruth — AI agents buy verified physical-world facts from humans. PayPal AI Hackathon 2026.",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "rehearse": "tsx scripts/rehearse.ts",
    "next-task": "node scripts/next-task.mjs",
    "check:protocol": "node scripts/check-protocol.mjs",
    "check:ignore": "node scripts/check-ignore.mjs",
    "check:paypal": "node scripts/check-no-live-paypal.mjs",
    "check:aggrid": "node scripts/check-aggrid.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:protocol && npm run check:ignore && npm run check:paypal && npm run check:aggrid && npm run check:secrets"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "ag-grid-community": "^34.3.1",
    "ag-grid-react": "^34.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.469.0",
    "next": "15.5.28",
    "postgres": "^3.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
